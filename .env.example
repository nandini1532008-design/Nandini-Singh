# MongoDB connection string (optional in local dev; falls back to local persistent JSON store if omitted or unreachable)
MONGO_URI="mongodb://127.0.0.1:27017/codesense-ai"

# Secret key for signing JWT authentication tokens
JWT_SECRET="replace-with-a-strong-random-secret"

# Google Gemini API key for server-side code review analysis
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server listening port (AI Studio uses 3000)
PORT="3000"

# Allowed CORS origin for the frontend client
CLIENT_URL="http://localhost:3000"

# Hosted App URL injected by runtime
APP_URL="MY_APP_URL"
